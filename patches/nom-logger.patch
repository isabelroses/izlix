@@ -0,0 +1,213 @@
+#include <gtest/gtest.h>
+
+#include "lix/libmain/nom-logger.hh"
+#include "lix/libstore/temporary-dir.hh"
+#include "lix/libutil/file-system.hh"
+#include "lix/libutil/strings.hh"
+#include "lix/libutil/terminal.hh"
+
+using namespace std::literals::chrono_literals;
+
+namespace nix {
+
+/** The frame as plain text: no colours, ordinary spaces, no padding at line ends. */
+static std::vector<std::string> plain(const std::vector<std::string> & lines)
+{
+    std::vector<std::string> res;
+    for (auto & line : lines) {
+        auto s = replaceStrings(filterANSIEscapes(line, true), " ", " ");
+        s.erase(s.find_last_not_of(' ') + 1);
+        res.push_back(s);
+    }
+    return res;
+}
+
+TEST(NomLogger, quietWhenIdle)
+{
+    NomLogger logger(false);
+    auto act = logger.startActivity(lvlDebug, actUnknown, "");
+
+    auto state = logger.state_.lock();
+    ASSERT_TRUE(logger.renderFrame(*state, NomLogger::Clock::now() + 5s, 80, 40).empty());
+}
+
+TEST(NomLogger, finishedBuildHangsBelowItsConsumer)
+{
+    auto dir = createTempDir();
+    AutoDelete cleanup(dir);
+    auto dep = dir + "/aaaa-dep-1.0.drv";
+    auto hello = dir + "/bbbb-hello-2.12.drv";
+    writeFile(dep, "Derive([],[],[],\"\",\"\",[],[])");
+    writeFile(hello, "Derive([],[(\"" + dep + "\",[\"out\"])],[],\"\",\"\",[],[])");
+
+    NomLogger logger(false);
+    auto builds = logger.startActivity(lvlDebug, actBuilds, "");
+    {
+        auto act = logger.startActivity(lvlDebug, actBuild, "", Logger::Fields{dep, "", 1, 1});
+    }
+    auto act = logger.startActivity(lvlDebug, actBuild, "", Logger::Fields{hello, "builder", 1, 1});
+    (void) act.result(resSetPhase, "buildPhase");
+    (void) builds.progress(1, 3, 1, 0);
+
+    auto state = logger.state_.lock();
+    auto frame = plain(logger.renderFrame(*state, NomLogger::Clock::now() + 65s, 80, 40));
+
+    ASSERT_EQ(
+        frame,
+        (std::vector<std::string>{
+            "╭─ Builds",
+            "├─ ⏵ hello-2.12  ⏱ 1m5s (buildPhase) builder",
+            "│  ╰─ ✔ dep-1.0",
+            "┢━ Status   Running   Completed   Waiting   Total",
+            "┃  Builds   ⏵ 1       ✔ 1         ⏸ 1       ∑ 3",
+            "┗━ Elapsed ⏱ 1m5s",
+        })
+    );
+}
+
+TEST(NomLogger, failureIsPinnedOnTheBuildThatStopped)
+{
+    NomLogger logger(false);
+    {
+        auto builds = logger.startActivity(lvlDebug, actBuilds, "");
+        {
+            auto act = logger.startActivity(
+                lvlDebug, actBuild, "", Logger::Fields{"/nix/store/aaaa-broken-1.0.drv", "", 1, 1}
+            );
+        }
+        (void) builds.progress(0, 0, 0, 1);
+    }
+
+    auto state = logger.state_.lock();
+    // Long after it stopped, where a build that succeeded would be gone.
+    auto now = NomLogger::Clock::now() + 65s;
+
+    ASSERT_EQ(
+        plain(logger.renderFrame(*state, now, 80, 40)),
+        (std::vector<std::string>{
+            "╭─ Builds",
+            "├─ ✗ broken-1.0",
+            "┢━ Status   Running   Completed   Waiting   Failed   Total",
+            "┃  Builds   ⏵ 0       ✔ 0         ⏸ 0       ✗ 1      ∑ 1",
+            "┗━ Elapsed ⏱ 1m5s",
+        })
+    );
+    ASSERT_EQ(
+        filterANSIEscapes(logger.finalStatus(*state, now), true),
+        "Exited with 1 failed build(s) after 1m5s"
+    );
+}
+
+TEST(NomLogger, transferShowsProgress)
+{
+    NomLogger logger(false);
+    auto act = logger.startActivity(
+        lvlDebug,
+        actFileTransfer,
+        "downloading 'https://example.org/src.tar.gz'",
+        {"https://example.org/src.tar.gz"}
+    );
+    (void) act.progress(512 * 1024, 2 * 1024 * 1024);
+
+    auto state = logger.state_.lock();
+    auto frame = plain(logger.renderFrame(*state, NomLogger::Clock::now() + 5s, 100, 40));
+
+    ASSERT_EQ(
+        frame,
+        (std::vector<std::string>{
+            "╭─ Builds",
+            "├─ ↓ https://example.org/src.tar.gz  ━━━━━━━─────────────────────   25%  512 KiB/2.0 MiB",
+            "┕━ Elapsed ⏱ 5s",
+        })
+    );
+}
+
+TEST(NomLogger, nerdIcons)
+{
+    NomLogger logger(false, {.nerdIcons = true});
+    auto act = logger.startActivity(
+        lvlDebug, actBuild, "", Logger::Fields{"/nix/store/aaaa-hello-2.12.drv", "", 1, 1}
+    );
+
+    auto state = logger.state_.lock();
+    auto frame = plain(logger.renderFrame(*state, NomLogger::Clock::now() + 5s, 80, 40));
+
+    ASSERT_EQ(frame[1], "├─ \uf04b hello-2.12  \uf017 5s");
+}
+
+TEST(NomLogger, estimatesFromEarlierBuilds)
+{
+    auto dir = createTempDir();
+    AutoDelete cleanup(dir);
+    auto history = dir + "/state/history.tsv";
+    createDirs(dir + "/state");
+    // Remembered by package, so that a new version still has an estimate.
+    writeFile(history, "hello\t\t30\nhello\t\t10\nhello\tbuilder\t500\nother\t\t7\nhello\t\t20\n");
+
+    NomLogger logger(false, {.historyFile = history});
+    {
+        auto dep = logger.startActivity(
+            lvlDebug, actBuild, "", Logger::Fields{"/nix/store/aaaa-dep-1.0.drv", "", 1, 1}
+        );
+    }
+    auto act = logger.startActivity(
+        lvlDebug, actBuild, "", Logger::Fields{"/nix/store/bbbb-hello-2.13.drv", "", 1, 1}
+    );
+
+    auto state = logger.state_.lock();
+    auto frame = plain(logger.renderFrame(*state, NomLogger::Clock::now() + 5s, 80, 40));
+    ASSERT_EQ(frame[1], "├─ ⏵ hello-2.13  ⏱ 5s ∅ 20s");
+
+    // Pretend that the finished build took a while, it is not kept otherwise.
+    state->builds[0].start -= 42s;
+    logger.saveHistory(*state);
+    logger.saveHistory(*state);
+    ASSERT_TRUE(readFile(history).ends_with("hello\t\t20\ndep\t\t42\n"));
+}
+
+TEST(NomLogger, cpuFromTheBuildCgroup)
+{
+    auto dir = createTempDir();
+    AutoDelete cleanup(dir);
+    auto cgroup = dir + "/system.slice/nix-daemon.service/nix-build@aaaa-30001";
+    createDirs(cgroup);
+    createDirs(dir + "/user.slice/nix-build@zzzz-30002");
+    writeFile(cgroup + "/cpu.stat", "usage_usec 1000000\nuser_usec 900000\nsystem_usec 100000\n");
+
+    NomLogger logger(false, {.cgroupRoot = dir});
+    auto act = logger.startActivity(
+        lvlDebug, actBuild, "", Logger::Fields{"/nix/store/aaaa-hello-2.12.drv", "", 1, 1}
+    );
+
+    auto state = logger.state_.lock();
+    auto now = NomLogger::Clock::now();
+    logger.sampleCpu(*state, now + 1s);
+    writeFile(cgroup + "/cpu.stat", "usage_usec 7000000\nuser_usec 6900000\nsystem_usec 100000\n");
+    logger.sampleCpu(*state, now + 5s);
+
+    ASSERT_EQ(state->builds[0].cgroup, std::filesystem::path(cgroup));
+    auto frame = plain(logger.renderFrame(*state, now + 5s, 80, 40));
+    ASSERT_EQ(frame[1], "├─ ⏵ hello-2.12  ⏱ 5s ⚙ 1.5");
+}
+
+TEST(NomLogger, tallFrameIsCutToTheTerminal)
+{
+    NomLogger logger(false);
+    std::vector<Activity> acts;
+    for (int i = 0; i < 20; i++) {
+        acts.push_back(logger.startActivity(
+            lvlDebug, actBuild, "", Logger::Fields{fmt("/nix/store/aaaa-pkg-%d.drv", i), "", 1, 1}
+        ));
+    }
+
+    auto state = logger.state_.lock();
+    auto frame = plain(logger.renderFrame(*state, NomLogger::Clock::now() + 5s, 80, 10));
+
+    // One line stays free for the cursor.
+    ASSERT_EQ(frame.size(), 9u);
+    ASSERT_EQ(frame[6], "├─ ⏵ pkg-5  ⏱ 5s");
+    ASSERT_EQ(frame[7], "├─ … 14 active");
+    ASSERT_EQ(frame[8], "┕━ Elapsed ⏱ 5s");
+}
+
