@@ -0,0 +1,244 @@
+#pragma once
+///@file
+
+#include <chrono>
+#include <condition_variable>
+#include <filesystem>
+#include <map>
+#include <optional>
+#include <thread>
+#include <vector>
+
+#include "lix/libutil/logging.hh"
+#include "lix/libutil/sync.hh"
+
+namespace nix {
+
+/**
+ * A logger that draws a tree of running builds and transfers with a status
+ * table underneath, in the style of the `nom` output monitor.
+ *
+ * Unlike an external monitor this only sees the activities Lix reports, so
+ * it knows how many builds are planned but not which ones. The tree is hence
+ * built bottom-up: a finished build is shown beneath the build that consumes
+ * it once that one starts.
+ */
+struct NomLogger : public Logger
+{
+    using Clock = std::chrono::steady_clock;
+    using TimePoint = Clock::time_point;
+
+    struct Icons
+    {
+        const char * running, * done, * planned, * failed;
+        const char * download, * upload;
+        const char * clock, * estimate, * cpu, * summary;
+    };
+
+    struct Options
+    {
+        /** Draw glyphs that only fonts patched by Nerd Fonts have. */
+        bool nerdIcons = false;
+        /** Where build durations are kept between runs; none are kept if unset. */
+        std::optional<Path> historyFile;
+        /** The cgroup v2 filesystem to look for build cgroups in, if any. */
+        std::optional<std::filesystem::path> cgroupRoot;
+    };
+
+    enum class BuildStatus : uint8_t { Running, Done, Failed };
+
+    struct Build
+    {
+        std::string name, host, phase;
+        /** The name without its version, which durations are remembered by. */
+        std::string package;
+        /** The hash part of the derivation path, which names its cgroup. */
+        std::string drvHash;
+        BuildStatus status = BuildStatus::Running;
+        TimePoint start, stop;
+        /** Index of the build that has this one as an input, if it has started. */
+        std::optional<size_t> parent;
+
+        /** Median duration of earlier builds of this package, in seconds. */
+        std::optional<uint64_t> estimate;
+        /** Whether the duration of this build went into the history. */
+        bool recorded = false;
+
+        std::optional<std::filesystem::path> cgroup;
+        /** CPU time the cgroup had used when it was last looked at. */
+        std::optional<uint64_t> cpuUsec;
+        TimePoint cpuSampledAt;
+        /** Cores kept busy between the last two looks. */
+        std::optional<double> cpuCores;
+    };
+
+    enum class RowKind : uint8_t { None, Generic, Waiting, Download, Upload };
+
+    struct ActInfo
+    {
+        ActivityType type = actUnknown;
+        ActivityId parent = 0;
+        TimePoint start;
+        uint64_t done = 0, expected = 0, running = 0, failed = 0;
+        std::map<ActivityType, uint64_t> expectedByType;
+
+        RowKind row = RowKind::None;
+        /** Text of the row; a package name, URI or message. */
+        std::string name, host;
+        /** Bytes moved by this transfer, or by the copy it wraps. */
+        uint64_t xferDone = 0, xferExpected = 0;
+        /** Index into `State::builds` if this is a build. */
+        std::optional<size_t> build;
+    };
+
+    struct Totals
+    {
+        uint64_t done = 0, expected = 0, failed = 0;
+    };
+
+    struct Counts
+    {
+        uint64_t done = 0, expected = 0, running = 0, failed = 0;
+    };
+
+    struct State
+    {
+        /** Ordered by id, which is also the order they started in. */
+        std::map<ActivityId, ActInfo> activities;
+        /** What already stopped activities contributed, by type. */
+        std::map<ActivityType, Totals> totals;
+
+        /** Every build seen so far, in the order they started. */
+        std::vector<Build> builds;
+        std::map<std::string, size_t> buildsByDrv;
+        /** How many reported build failures were pinned on a build. */
+        uint64_t failuresAssigned = 0;
+
+        bool sawDownload = false, sawUpload = false;
+
+        /** The last few durations per package and host, oldest first. */
+        std::map<std::pair<std::string, std::string>, std::vector<uint64_t>> history;
+        bool historyLoaded = false;
+
+        /** The cgroup that holds the build cgroups, once one was found. */
+        std::optional<std::filesystem::path> cgroupParent;
+        /** How often the whole cgroup tree was searched in vain. */
+        unsigned cgroupSearches = 0;
+        TimePoint cpuSampledAt;
+
+        /** Set while there is work the final status line should report. */
+        bool dirty = false;
+        std::optional<TimePoint> sessionStart;
+
+        /** The frame as it was last drawn, and how many lines of it are on screen. */
+        std::string lastFrame;
+        int lastFrameLines = 0;
+        int lastLines = 0;
+        /** Whether the frame has something that moves faster than a timer. */
+        bool animated = false;
+
+        uint32_t paused = 1;
+        bool haveUpdate = false;
+    };
+
+    Sync<State> state_;
+
+    std::thread updateThread;
+
+    std::condition_variable quitCV, updateCV;
+
+    bool printBuildLogs = false;
+    bool isTTY;
+    Options options;
+    const Icons & icons;
+
+    NomLogger(bool isTTY);
+
+    NomLogger(bool isTTY, Options options);
+
+    ~NomLogger();
+
+    void pause() override;
+
+    void resetProgress() override;
+
+    void resume() override;
+
+    bool isVerbose() override;
+
+    BufferState log(Verbosity lvl, std::string_view s) override;
+
+    BufferState logEI(const ErrorInfo & ei) override;
+
+    BufferState startActivityImpl(
+        ActivityId act,
+        Verbosity lvl,
+        ActivityType type,
+        const std::string & s,
+        const Fields & fields,
+        ActivityId parent
+    ) override;
+
+    BufferState stopActivityImpl(ActivityId act) override;
+
+    BufferState
+    resultImpl(ActivityId act, ResultType type, const std::vector<Field> & fields) override;
+
+    void writeToStdout(std::string_view s) override;
+
+    std::optional<std::string> ask(std::string_view msg) override;
+
+    void setPrintBuildLogs(bool printBuildLogs) override;
+
+    /** Sums up the live and finished activities of one type. */
+    Counts tally(State & state, ActivityType type);
+
+    /** The status table that closes the frame. */
+    std::vector<std::string> renderLegend(State & state, TimePoint now, size_t width);
+
+    /**
+     * The whole frame, one string per terminal line, at most `height - 1`
+     * lines tall. Empty when there is nothing to show.
+     */
+    std::vector<std::string>
+    renderFrame(State & state, TimePoint now, size_t width, size_t height);
+
+    /** The line printed when the logger is paused after doing some work. */
+    std::string finalStatus(State & state, TimePoint now);
+
+    /**
+     * Measures how many cores each running local build keeps busy, from the
+     * cgroup Lix runs it in. Does nothing more often than once a second.
+     */
+    void sampleCpu(State & state, TimePoint now);
+
+    /** Appends the durations of the builds that succeeded to the history. */
+    void saveHistory(State & state);
+
+    /**
+     * Whether to expect a Nerd Font: what `NERD_FONTS` says, and failing
+     * that whether this is a terminal that falls back to one by itself.
+     */
+    static bool detectNerdFonts();
+
+private:
+    BufferState log(State & state, std::string_view s);
+
+    bool hasAncestor(State & state, ActivityType type, ActivityId act);
+
+    void loadHistory(State & state);
+
+    void update(State & state);
+
+    void erase(State & state);
+
+    /** Puts the erased frame back as it was, without working it out again. */
+    void restore(State & state);
+
+    /** Redraws the frame; unless `force` is set, only if it changed. */
+    void draw(State & state, bool force);
+};
+
+Logger * makeNomLogger();
+
+}
